+"""Regression test for keyword-precedence misclassification in task_contract.
+
+auto_router/task_contract.py resolves a task's kind by scanning a fixed keyword map
+and returning on the *first* substring match. The map lists ``analysis`` before
+``code``, and ``analysis`` matches the bare word ``review``. So a request to
+review a handler and add a regression test -- unambiguously code work -- is
+classified ``analysis``, which flips ``task_evidence_required`` to True and hands
+the task the analysis plan instead of the code plan.
+
+The same request without the word "review" is classified ``code``. That is the
+defect: one incidental keyword decides the entire contract.
+"""
+from auto_router.task_contract import normalize_task_kind, task_evidence_required
+
+
+def test_incidental_review_word_does_not_reclassify_a_code_task():
+    """Adding a regression test is code work even when the text says "review"."""
+    payload = {"task": "review the failing handler and add a regression test"}
+    assert normalize_task_kind(payload) == "code"
+
+
+def test_code_task_mentioning_review_is_not_marked_evidence_required():
+    """The misclassification must not leak into the rest of the contract."""
+    payload = {"task": "review the failing handler and add a regression test"}
+    assert task_evidence_required(payload) is False
+
+
+def test_classification_does_not_depend_on_an_incidental_keyword():
+    """Same task, two phrasings: an incidental word must not change the kind."""
+    with_review = {"task": "review the failing handler and add a regression test"}
+    without_review = {"task": "add a regression test for the failing handler"}
+    assert normalize_task_kind(with_review) == normalize_task_kind(without_review) == "code"
