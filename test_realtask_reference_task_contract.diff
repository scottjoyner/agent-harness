+#: Kinds that receive an explicit, domain-specific plan rather than the generic
+#: fallback. Every one of these can only be carried out with tool access, so the
+#: contract must classify them as tool_required. Defining the set once keeps
+#: task_requires_tools, task_plan_steps and task_validation_metrics from
+#: disagreeing about the same kind.
+_CODE_KINDS = frozenset({
+    "code", "implementation", "refinement", "repair", "review", "repo", "patch",
+})
+_RESEARCH_KINDS = frozenset({"research", "analysis", "documentation", "docs"})
+_OPERATIONS_KINDS = frozenset({"operations", "terminal", "shell"})
+
+_PLAN_EXPLICIT_KINDS = _CODE_KINDS | _RESEARCH_KINDS | _OPERATIONS_KINDS
+
+
