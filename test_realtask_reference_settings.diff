 from pydantic_settings import BaseSettings, SettingsConfigDict
 
 
+_SQLITE_PREFIX = "sqlite:///"
+
+
+def _resolve_sqlite_path(configured_url: str) -> str | None:
+    """Resolve a ``sqlite:///`` URL to a filesystem path, or ``None``.
+
+    The deployment contract used by Compose: ``sqlite:///data/x`` means
+    ``/data/x``, while ``sqlite:///./data/x`` remains workdir-relative. This is
+    the single owner of that grammar so every reader agrees.
+    """
+    if not configured_url.startswith(_SQLITE_PREFIX):
+        return None
+    raw_path = configured_url[len(_SQLITE_PREFIX):]
+    if raw_path == ":memory:":
+        return ":memory:"
+    if raw_path.startswith(("/", "./", "../")):
+        return os.path.abspath(raw_path)
+    return os.path.abspath(os.path.join(os.sep, raw_path))
+
+
